{
  "name": "oberliga-tippspiel",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:web": "expo start --web",
    "build:web": "expo export --platform web && node scripts/generate-service-worker.mjs",
    "deploy:web": "npm run build:web && wrangler deploy",
    "generate:deb-seed": "node scripts/generate-deb-seed.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "check": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.14",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@supabase/supabase-js": "^2.57.4",
    "expo": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.127.1"
  }
}
